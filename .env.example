# Canonical URL for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, /api/checkout creates a real Stripe Checkout session (test keys recommended).
# Left empty, checkout runs in mock mode and no money moves.
STRIPE_SECRET_KEY=

# Reserved for the Supabase backend described in supabase/schema.sql. Not read by the app yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
